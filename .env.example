# Copy to .env and fill in local values (.env is gitignored).

# Keycloak OIDC provider — realm base URL + confidential client
# NOTE: BASE_URL is read at BUILD time (it is baked into authorizationUrl/tokenUrl). In Docker
# it must be passed as a build arg, not only as a runtime env, see docs/deployment-de.md.
# Local Keycloak still uses the legacy /auth path prefix; the hosted one (Keycloak 17+) does NOT.
NUXT_OIDC_PROVIDERS_KEYCLOAK_BASE_URL=http://localhost:8282/auth/realms/UrbanModelPlatform
NUXT_OIDC_PROVIDERS_KEYCLOAK_CLIENT_ID=ump-client
NUXT_OIDC_PROVIDERS_KEYCLOAK_CLIENT_SECRET=

# OIDC redirect targets — override for prod (defaults in nuxt.config.ts point at localhost).
# Every value here must also be registered on the ump-client in Keycloak, or login fails
# at Keycloak with "Invalid parameter: redirect_uri".
NUXT_OIDC_PROVIDERS_KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/keycloak/callback
NUXT_OIDC_PROVIDERS_KEYCLOAK_LOGOUT_REDIRECT_URI=http://localhost:3000

# OIDC session/token encryption
# secrets: openssl rand -hex 24   |   token key: openssl rand -base64 32
NUXT_OIDC_SESSION_SECRET=
NUXT_OIDC_AUTH_SESSION_SECRET=
NUXT_OIDC_TOKEN_KEY=

# UMP API proxy target (server-side)
NUXT_UMP_API_TARGET=http://localhost:5003
